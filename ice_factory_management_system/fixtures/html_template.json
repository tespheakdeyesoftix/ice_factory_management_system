  "name": "html_customer_recent_payment",
  "template": "{% set data = frappe.db.sql(\"\"\"\n    SELECT\n        name AS id,\n        customer_name,\n        posting_date,\n        total_amount,\n        owner AS created_by,\n        outlet,\n        balance,\n        amount_to_pay,\n        payment_amount,\n        write_off_amount,\n        creation AS created_date\n    FROM `tabSale Payment`\n    WHERE customer = %(customer)s\n    ORDER BY creation asc\n    LIMIT 20\n\"\"\", {\"customer\": doc.name}, as_dict=1) %}\n\n<div class=\"card shadow-sm pb-0\">\n  <div class=\"card-header d-flex justify-content-between align-items-center\">\n    <h5 class=\"mb-0\">{{_(\"Payments\")}}</h5>\n      <a  class=\"btn btn-sm btn-primary\" \n href=\"/desk/sale-payment?customer={{doc.name}}\" target=\"_blank\">\n               {{_(\"View All\")}} \n            </a>\n  </div>\n{% if data %}\n<div class=\"table-responsive mt-0\">\n    <table class=\"table table-hover align-middle mt-0\">\n        <thead class=\"table-light\">\n<tr>\n    <th>{{ _(\"Invoice No\") }}</th>\n    <th>{{ _(\"Payment Date\") }}</th>\n    <th>{{ _(\"Outlet\") }}</th>\n    <th class=\"text-right\">{{ _(\"Sale Balance\") }}</th>\n    <th class=\"text-right\">{{ _(\"Payment Amount\") }}</th>\n    <th class=\"text-right\">{{ _(\"Write Off Amount\") }}</th>\n    <th class=\"text-right\">{{ _(\"Balance\") }}</th>\n    <th>{{ _(\"Created By\") }}</th>\n    <th>{{ _(\"Date\") }}</th>\n</tr>\n\n        </thead>\n        <tbody>\n\n        {% for row in data %}\n\n\n            <tr style=\"cursor:pointer; background-color: {{ bg }};\"\n                onclick=\"window.open('/app/sale-payment/{{ row.id }}', '_blank')\">\n\n                <td class=\"fw-semibold text-primary\">\n                    {{ row.id }}\n                </td>\n                 <td class=\"fw-semibold text-primary\">\n                  {{ row.posting_date.strftime('%d-%m-%Y') }}\n\n\n                </td>\n\n                <td>\n                    {{ _(row.outlet) or \"-\" }}\n                </td>\n                <td class=\"text-right fw-bold\">\n                     {{ frappe.format_value(row.amount_to_pay, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold text-success\">\n                      {{ frappe.format_value(row.payment_amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold  text-danger\">\n                    {{ frappe.format_value(row.write_off_amount or 0, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold\">\n                    {{ frappe.format_value(row.balance or 0, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n\n                <td>\n            {{ row.created_by.split('@')[0] }}\n\n                </td>\n<td title=\"{{ frappe.utils.format_datetime(row.created_date, 'dd-MM-yyyy HH:mm') }}\"\n >\n    {{ frappe.utils.pretty_date(row.created_date) }}\n</td>\n            </tr>\n\n        {% endfor %}\n        </tbody>\n<tfoot class=\"table-light fw-bold\">\n  <tr>\n    <td colspan=4>{{ _(\"Total\") }}</td>\n    <td class=\"text-right\">\n  {% set total_payment = data | sum(attribute='payment_amount') %}\n  {{ frappe.format_value(total_payment, {\"fieldtype\":\"Currency\"}) }}\n\n\n    </td>\n        <td class=\"text-right\">\n  {% set total_write_off_amount = data | sum(attribute='write_off_amount') %}\n  {{ frappe.format_value(total_write_off_amount, {\"fieldtype\":\"Currency\"}) }}\n\n\n    </td>\n      <td class=\"text-right\">\n  {{ frappe.format_value(doc.balance or 0, {\"fieldtype\":\"Currency\"}) }}\n\n\n    </td>\n     <td colspan=5></td>\n  </tr>\n</tfoot>\n\n    </table>\n</div>\n\n{% else %}\n<div class=\"text-center text-muted py-4\">\n   {{_(\"No Data\")}} \n</div>\n{% endif %}\n</div>\n",
  "template_name": "html_customer_recent_payment"
 },
 {
