  "name": "html_customer_borrow_return_product",
  "template": "{% set data = frappe.db.sql(\"\"\"\r\n    SELECT\r\n        name AS id,\r\n        posting_date,\r\n        transaction_type,\r\n        outlet,\r\n        owner AS created_by,\r\n        product_name,\r\n        return_quantity,\r\n        balance,\r\n        borrow_reference_name,\r\n        cost,\r\n        quantity * IF(transaction_type='Return', -1, 1) AS quantity,\r\ntotal_cost * IF(transaction_type='Return', -1, 1) AS total_cost ,\r\n        customer_name,\r\n        creation as created_date\r\n    FROM `tabBorrow Product`\r\n    WHERE customer = %(customer)s\r\n    ORDER BY creation asc\r\n    LIMIT 20\r\n\"\"\", {\"customer\": doc.name}, as_dict=1) %}\r\n\r\n<div class=\"card shadow-sm pb-0\">\r\n  <div class=\"card-header d-flex justify-content-between align-items-center\">\r\n    <h5 class=\"mb-0\">{{_(\"Borrow Product\")}}</h5>\r\n            <button class=\"btn btn-sm btn-primary\"\r\n        onclick=\"\r\n            frappe.route_options = { customer: '{{ doc.name }}' };\r\n            frappe.set_route('List', 'Borrow Product');\r\n        \">\r\n    {{ _('View All') }}\r\n</button>\r\n  </div>\r\n{% if data %}\r\n<div class=\"table-responsive mt-0\">\r\n    <table class=\"table table-hover align-middle mt-0\">\r\n        <thead class=\"table-light\">\r\n<tr>\r\n    <th>{{ _(\"Invoice No\") }}</th>\r\n    <th>{{ _(\"Date\") }}</th>\r\n    <th>{{ _(\"Outlet\") }}</th>\r\n    <th class=\"text-right\">{{ _(\"Product Name\") }}</th>\r\n    <th class=\"text-right\">{{ _(\"Cost\") }}</th>\r\n    <th class=\"text-center\">{{ _(\"Borrow\") + \" / \" + _(\"Return\") + \" / \" + _(\"Balance\") }}</th>\r\n    \r\n    <th class=\"text-right\">{{ _(\"Total Amount\") }}</th>\r\n     <th class=\"text-center\">{{ _(\"Type\") }}</th>\r\n    <th>{{ _(\"Created By\") }}</th>\r\n    <th>{{ _(\"Created Date\") }}</th>\r\n</tr>\r\n\r\n        </thead>\r\n        <tbody>\r\n\r\n     {% for parent in data if not parent.borrow_reference_name %}\r\n\r\n    {# --- PARENT ROW --- #}\r\n    {% set color = 'text-success' %}\r\n    {% if parent.transaction_type == 'Borrow' %}\r\n        {% set color = 'text-danger' %}\r\n    {% endif %}\r\n\r\n    <tr style=\"cursor:pointer; font-weight:600;\"\r\n        onclick=\"frappe.set_route('Form', 'Borrow Product', '{{ parent.id }}')\">\r\n        <td class=\"fw-semibold text-primary\">{{ parent.id }}</td>\r\n        <td class=\"fw-semibold text-primary\">{{ parent.posting_date.strftime('%d-%m-%Y') }}</td>\r\n        <td>{{ _(parent.outlet) or \"-\" }}</td>\r\n        <td class=\"text-right fw-bold\">{{ parent.product_name }}</td>\r\n        <td class=\"text-right fw-bold {{ color }}\">{{ frappe.format_value(parent.cost or 0, {\"fieldtype\":\"Currency\"}) }}</td>\r\n        <td class=\"text-center\">\r\n            <span class=\"text-center fw-bold {{ color }}\">{{ parent.quantity | int | abs }}</span>  / \r\n            <span class=\"text-center fw-bold text-success\">{{ parent.return_quantity | int | abs }}</span>  / \r\n            <span class=\"text-center fw-bold \">{{ parent.balance | int | abs }}</span>\r\n            \r\n        \r\n        </td>\r\n        <td class=\"text-right fw-bold\">{{ frappe.format_value(parent.total_cost | abs or 0, {\"fieldtype\":\"Currency\"}) }}</td>\r\n        <td class=\"text-center fw-bold\">\r\n            <span class=\"indicator-pill {{ 'orange' if parent.transaction_type == 'Borrow' else 'green' }}\">\r\n                {{ _(parent.transaction_type) }}\r\n            </span>\r\n        </td>\r\n        <td>{{ parent.created_by.split('@')[0] }}</td>\r\n        <td title=\"{{ frappe.utils.format_datetime(parent.created_date, 'dd-MM-yyyy HH:mm') }}\">\r\n            {{ frappe.utils.pretty_date(parent.created_date) }}\r\n        </td>\r\n    </tr>\r\n\r\n    {# --- CHILD ROWS --- #}\r\n    {% for child in data if child.borrow_reference_name == parent.id %}\r\n\r\n        {% set child_color = 'text-success' %}\r\n        {% if child.transaction_type == 'Borrow' %}\r\n            {% set child_color = 'text-danger' %}\r\n        {% endif %}\r\n\r\n        <tr style=\"cursor:pointer; background:#f9fafb;\"\r\n            onclick=\"frappe.set_route('Form', 'Borrow Product', '{{ child.id }}')\">\r\n            <td class=\"fw-semibold text-muted ps-4\">↳ {{ child.id }}</td>\r\n            <td class=\"fw-semibold text-muted\">{{ child.posting_date.strftime('%d-%m-%Y') }}</td>\r\n            <td>{{ _(child.outlet) or \"-\" }}</td>\r\n            <td class=\"text-right fw-bold\">{{ child.product_name }}</td>\r\n            <td class=\"text-right fw-bold {{ child_color }}\">{{ frappe.format_value(child.cost or 0, {\"fieldtype\":\"Currency\"}) }}</td>\r\n            <td class=\"text-center fw-bold {{ child_color }}\">{{ child.quantity | int | abs }}</td>\r\n            <td class=\"text-right fw-bold\">{{ frappe.format_value(child.total_cost | abs or 0, {\"fieldtype\":\"Currency\"}) }}</td>\r\n            <td class=\"text-center fw-bold\">\r\n                <span class=\"indicator-pill {{ 'orange' if child.transaction_type == 'Borrow' else 'green' }}\">\r\n                    {{ _(child.transaction_type) }}\r\n                </span>\r\n            </td>\r\n            <td>{{ child.created_by.split('@')[0] }}</td>\r\n            <td title=\"{{ frappe.utils.format_datetime(child.created_date, 'dd-MM-yyyy HH:mm') }}\">\r\n                {{ frappe.utils.pretty_date(child.created_date) }}\r\n            </td>\r\n        </tr>\r\n\r\n    {% endfor %}\r\n\r\n{% endfor %}\r\n\r\n        </tbody>\r\n\r\n\r\n    </table>\r\n</div>\r\n\r\n{% else %}\r\n<div class=\"text-center text-muted py-4\">\r\n   {{_(\"No Data\")}} \r\n</div>\r\n{% endif %}\r\n</div>\r\n",
  "template_name": "html_customer_borrow_return_product"
 },
