rappe.set_route('Form', 'Borrow Product', '{{ row.id }}')\">\r\n                <td class=\"fw-semibold text-primary\">\r\n                    {{ row.id }}\r\n                </td>\r\n                 <td class=\"fw-semibold text-primary\">\r\n                  {{ row.posting_date.strftime('%d-%m-%Y') }}\r\n                </td>\r\n                <td>\r\n                    {{ _(row.outlet) or \"-\" }}\r\n                </td>\r\n                <td class=\"text-right fw-bold\">\r\n                     {{ row.product_name }}\r\n                </td>\r\n               <td class=\"text-right fw-bold {{ color }}\">\r\n    {{ frappe.format_value(row.cost or 0, {\"fieldtype\":\"Currency\"}) }}\r\n</td>\r\n\r\n<td class=\"text-center fw-bold {{ color }}\">\r\n    {{ row.quantity | int | abs }}\r\n</td>\r\n\r\n                <td class=\"text-right fw-bold\">\r\n                    {{ frappe.format_value(row.total_cost | abs or 0, {\"fieldtype\":\"Currency\"}) }}\r\n                </td>\r\n                <td>\r\n            {{ row.created_by.split('@')[0] }}\r\n                </td>\r\n                <td title=\"{{ frappe.utils.format_datetime(row.created_date, 'dd-MM-yyyy HH:mm') }}\"\r\n >\r\n    {{ frappe.utils.pretty_date(row.created_date) }}\r\n</td>\r\n\r\n            </tr>\r\n\r\n        {% endfor %}\r\n        </tbody>\r\n\r\n\r\n    </table>\r\n</div>\r\n\r\n{% else %}\r\n<div class=\"text-center text-muted py-4\">\r\n   {{_(\"No Data\")}} \r\n</div>\r\n{% endif %}\r\n</div>\r\n",
