 {
  "css": "",
  "docstatus": 0,
  "doctype": "HTML Template",
  "modified": "2025-12-20 14:05:33.178639",
  "name": "Sale_sidebar",
  "template": "<ul class=\"list-group list-group-flush mx-4 border-top\">\r\n    {%if doc.reference_number%}\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Reference #\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.reference_number or \"\"}}</span>\r\n  </li>\r\n  {%endif%}\r\n<!-- Parent Bill Number-->\r\n    {%if doc.parent_bill_number %}\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Parent Bill #\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\"><a href=\"/desk/sale/{{doc.parent_bill_number}}\">{{doc.parent_bill_number or \"\"}}</a></span>\r\n  </li>\r\n  {%endif%}\r\n  \r\n<!-- Total Split Bill-->\r\n    {%if doc.total_split_bill>0 %}\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Total Split Bill\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.total_split_bill}}</span>\r\n  </li>\r\n  {%endif%}\r\n  \r\n\r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n \r\n    <span class=\"text-muted\">{{_(\"Status\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{_(doc.status)}} - {{_(doc.sale_status)}}</span>\r\n  </li>\r\n  <!--Station Name-->\r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n \r\n    <span class=\"text-muted\">{{_(\"Station Name\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.station or \"\"}}</span>\r\n  </li>\r\n  <!--Last Update Station Name-->\r\n  {% if doc.last_update_station %}\r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n \r\n    <span class=\"text-muted\">{{_(\"Last Update PC\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.last_update_station or \"\"}}</span>\r\n  </li>\r\n  {%endif%}\r\n \r\n \r\n\r\n \r\n\r\n  \r\n\r\n    {%if doc.sale_status == 'Deleted'%}\r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Deleted Date\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{frappe.format(doc.deleted_date,{\"fieldtype\":\"Datetime\"})}}</span>\r\n  </li>\r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Deleted By\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.deleted_by}}</span>\r\n  </li>\r\n  \r\n  <li class=\"list-group-item d-flex align-items-center px-0\">\r\n    <span class=\"text-muted\">{{_(\"Note\")}}</span>\r\n    <span class=\"ml-auto font-weight-bold\">{{doc.deleted_note}}</span>\r\n  </li>\r\n  \r\n  {%endif%}\r\n  \r\n\r\n</ul>\r\n<h5 class=\"px-4 py-2 mb-1 border-bottom\">\r\n  {{_(\"Quantity Summary\")}}\r\n</h5>\r\n<ul class=\"list-group list-group-flush mx-4\">\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Total Select Quantity\")}}</span>\r\n        <span class=\"ml-auto font-weight-bold\">{{doc.total_quantity}}</span>\r\n    </li>\r\n    \r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Free Quantity\")}}</span>\r\n        <span class=\"ml-auto text-danger\">{{doc.total_free}}</span>\r\n    </li>\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Return Quantity\")}}</span>\r\n        <span class=\"ml-auto text-danger\">{{doc.total_quantity_return}}</span>\r\n    </li>\r\n    \r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Split Quantity\")}}</span>\r\n        <span class=\"ml-auto text-danger\">{{doc.total_split_quantity}}</span>\r\n    </li>\r\n    \r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Total Sale Quantity\")}}</span>\r\n        <span class=\"ml-auto text-success\"><strong>{{doc.total_sale_quantity}}</strong></span>\r\n    </li>\r\n</ul>\r\n\r\n<ul class=\"list-group list-group-flush mx-4 border-top\">\r\n    <li class=\"list-group-item d-flex align-items-center px-0\">\r\n        <span class=\"text-muted\">{{_(\"Seller\")}}</span>\r\n        <span class=\"ml-auto font-weight-bold\">{{doc.seller or doc.owner.split(\"@\")[0]}} </span>\r\n    </li>\r\n</ul>\r\n ",
  "template_name": "Sale_sidebar"
 },
 {
