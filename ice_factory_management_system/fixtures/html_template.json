  "modified": "2025-12-20 16:46:47.485274",
  "name": "html_customer_borrow_return_product",
  "template": "{% set data = frappe.db.sql(\"\"\"\r\n    SELECT\r\n        name AS id,\r\n        posting_date,\r\n        transaction_type,\r\n        outlet,\r\n        owner AS created_by,\r\n        product_name,\r\n        cost,\r\n        quantity * IF(transaction_type='Return', -1, 1) AS quantity,\r\ntotal_cost * IF(transaction_type='Return', -1, 1) AS total_cost ,\r\n        customer_name,\r\n        creation as created_date\r\n    FROM `tabBorrow Product`\r\n    WHERE customer = %(customer)s\r\n    ORDER BY creation asc\r\n    LIMIT 20\r\n\"\"\", {\"customer\": doc.name}, as_dict=1) %}\r\n\r\n<div class=\"card shadow-sm pb-0\">\r\n  <div class=\"card-header d-flex justify-content-between align-items-center\">\r\n    <h5 class=\"mb-0\">{{_(\"Borrow Product\")}}</h5>\r\n      <a  class=\"btn btn-sm btn-primary\" target=\"_blank\" href=\"/app/borrow-product?customer={{ doc.name }}\">\r\n               {{_(\"View All\")}} \r\n            </a>\r\n  </div>\r\n{% if data %}\r\n<div class=\"table-responsive mt-0\">\r\n    <table class=\"table table-hover align-middle mt-0\">\r\n        <thead class=\"table-light\">\r\n<tr>\r\n    <th>{{ _(\"Invoice No\") }}</th>\r\n    <th>{{ _(\"Date\") }}</th>\r\n    <th>{{ _(\"Outlet\") }}</th>\r\n    <th class=\"text-right\">{{ _(\"Product Name\") }}</th>\r\n    <th class=\"text-right\">{{ _(\"Cost\") }}</th>\r\n    <th class=\"text-center\">{{ _(\"Quantity\") }}</th>\r\n    \r\n    <th class=\"text-right\">{{ _(\"Total Amount\") }}</th>\r\n     <th class=\"text-center\">{{ _(\"Type\") }}</th>\r\n    <th>{{ _(\"Created By\") }}</th>\r\n    <th>{{ _(\"Created Date\") }}</th>\r\n</tr>\r\n\r\n        </thead>\r\n        <tbody>\r\n\r\n        {% for row in data %}\r\n        {% set color = 'text-success' %}\r\n{% if row.transaction_type == 'Borrow' %}\r\n    {% set color = 'text-danger' %}\r\n{% endif %}\r\n\r\n            <tr style=\"cursor:pointer; background-color: {{ bg }};\"\r\n                onclick=\"window.open('/app/borrow-product/{{ row.id }}', '_blank')\">\r\n                <td class=\"fw-semibold text-primary\">\r\n                    {{ row.id }}\r\n                </td>\r\n                 <td class=\"fw-semibold text-primary\">\r\n                  {{ row.posting_date.strftime('%d-%m-%Y') }}\r\n                </td>\r\n                <td>\r\n                    {{ _(row.outlet) or \"-\" }}\r\n                </td>\r\n                <td class=\"text-right fw-bold\">\r\n                     {{ row.product_name }}\r\n                </td>\r\n               <td class=\"text-right fw-bold {{ color }}\">\r\n    {{ frappe.format_value(row.cost or 0, {\"fieldtype\":\"Currency\"}) }}\r\n</td>\r\n\r\n<td class=\"text-center fw-bold {{ color }}\">\r\n    {{ row.quantity | int | abs }}\r\n</td>\r\n\r\n                <td class=\"text-right fw-bold\">\r\n                    {{ frappe.format_value(row.total_cost | abs or 0, {\"fieldtype\":\"Currency\"}) }}\r\n                </td>\r\n                 <td class=\"text-center fw-bold\">\r\n<span class=\"indicator-pill no-indicator-dot whitespace-nowrap\r\n    {{ 'orange' if row.transaction_type == 'Borrow' else 'green' }}\">\r\n    <span>{{ _(row.transaction_type) }}</span>\r\n</span>\r\n\r\n                </td>\r\n                <td>\r\n            {{ row.created_by.split('@')[0] }}\r\n                </td>\r\n                <td title=\"{{ frappe.utils.format_datetime(row.created_date, 'dd-MM-yyyy HH:mm') }}\"\r\n >\r\n    {{ frappe.utils.pretty_date(row.created_date) }}\r\n</td>\r\n\r\n            </tr>\r\n\r\n        {% endfor %}\r\n        </tbody>\r\n<tfoot class=\"table-light fw-bold\">\r\n  <tr>\r\n    <td colspan=5>{{ _(\"Total\") }}</td>\r\n   \r\n        <td class=\"text-center\">\r\n\r\n{% set quantity_amount = data | sum(attribute='quantity') %}\r\n{{ quantity_amount | int }}\r\n\r\n    </td>\r\n       <td class=\"text-right\">\r\n\r\n{% set total_cost_amount = data | sum(attribute='total_cost') %}\r\n{{ frappe.format_value(total_cost_amount or 0, {\"fieldtype\":\"Currency\"}) }}\r\n\r\n    </td>\r\n     <td colspan=5></td>\r\n  </tr>\r\n</tfoot>\r\n\r\n    </table>\r\n</div>\r\n\r\n{% else %}\r\n<div class=\"text-center text-muted py-4\">\r\n   {{_(\"No Data\")}} \r\n</div>\r\n{% endif %}\r\n</div>\r\n",
  "template_name": "html_customer_borrow_return_product"
 },
