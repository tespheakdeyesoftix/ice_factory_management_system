 },
 {
  "css": null,
  "docstatus": 0,
  "doctype": "HTML Template",
  "modified": "2025-12-19 11:17:00.967347",
  "name": "html_sale_split_bill_list",
  "template": "{% set data = frappe.db.sql(\"\"\"\n    SELECT\n        name AS id,\n        customer_name,\n        total_sale_quantity AS quantity,\n        total_amount AS total_amount,\n        owner AS created_by,\n        status,\n        creation AS created_date\n    FROM `tabSale`\n    WHERE parent_bill_number = %(name)s\n\"\"\", {\"name\": doc.name}, as_dict=1) %}\n<div class=\"row g-3\">\n    {% if data %}\n        {% for row in data %}\n        <div  class=\"col-12 col-md-6 col-lg-4 mt-2 mt-lg-0\">\n            <div class=\"card h-100 shadow-sm border-0 cursor-pointer\"\n                 onclick=\"window.open('/app/sale/{{ row.id }}', '_blank')\"\n                 style=\"cursor:pointer;\" >\n                <div class=\"card-body p-3\">\n\n                    <!-- Header -->\n                    <div class=\"d-flex justify-content-between align-items-center mb-2\">\n                        <span class=\"fw-semibold text-primary\">\n                            {{ row.id }}\n                        </span>\n                          {% set badge = \"orange\" %}\n{% if row.status == \"Paid\" %}\n    {% set badge = \"green\" %}\n{% elif row.status == \"Unpaid\" %}\n    {% set badge = \"red\" %}\n{% endif %}\n\n<span class=\"indicator-pill {{ badge }} no-indicator-dot whitespace-nowrap\">\n    <span>{{ _(row.status) }}</span>\n</span>\n                    </div>\n\n                    <!-- Customer -->\n                    <div class=\"mb-2\">\n                        <small class=\"text-muted\">{{_(\"Customer\")}}</small>\n                        <div class=\"fw-semibold\">\n                            {{ row.customer_name or \"-\" }}\n                        </div>\n                    </div>\n\n                    <!-- Amount -->\n                    <div class=\"d-flex justify-content-between\">\n                    <div class=\"mb-2\">\n                        <small class=\"text-muted\">{{_(\"Quantity\")}}</small>\n                        <div class=\"fs-5 fw-bold\">\n                            {{ row.quantity | int }}\n                        </div>\n                    </div>\n                    <div class=\"mb-2\">\n                        <small class=\"text-muted\">{{_(\"Total Amount\")}}</small>\n                        <div class=\"fs-5 fw-bold text-success\">\n                             {{ frappe.format_value(row.total_amount, {\"fieldtype\":\"Currency\"}) }}\n                        </div>\n                    </div>\n                    </div>\n\n                    <hr class=\"my-2\">\n\n                    <!-- Footer -->\n                    <div class=\"d-flex justify-content-between small text-muted\">\n                        <span>\n                            <i class=\"fa fa-user me-1\"></i>\n                            {{ row.created_by.split('@')[0] }}\n                        </span>\n                        <span>\n                            {{ frappe.utils.format_datetime(row.created_date) }}\n                        </span>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n        {% endfor %}\n    {% else %}\n        <div class=\"col-12\">\n            <div class=\"text-center text-muted py-4\">\n               {{_(\"No Data\")}} \n            </div>\n        </div>\n    {% endif %}\n</div>\n",
  "template_name": "html_sale_split_bill_list"
 },
 {
  "css": null,
  "docstatus": 0,
  "doctype": "HTML Template",
  "modified": "2025-12-24 16:57:01.039515",
  "name": "html_customer_recent_sale",
  "template": "{% set data = frappe.db.sql(\"\"\"\n    SELECT\n        name AS id,\n        customer_name,\n        total_sale_quantity AS quantity,\n        total_amount AS total_amount,\n        owner AS created_by,\n        outlet,\n        sale_status,\n        workflow_state,\n        status,\n        creation AS created_date\n    FROM `tabSale`\n    WHERE customer = %(name)s\n    ORDER BY creation DESC\n    LIMIT 20\n\"\"\", {\"name\": doc.name}, as_dict=1) %}\n\n<div class=\"card shadow-sm pb-0\">\n  <div class=\"card-header d-flex justify-content-between align-items-center\">\n    <h5 class=\"mb-0\">{{_(\"Recent Sale\")}}</h5>\n\n                <button class=\"btn btn-sm btn-primary\"\n        onclick=\"\n            frappe.route_options = { customer: '{{ doc.name }}' };\n            frappe.set_route('List', 'Sale');\n        \">\n    {{ _('View All') }}\n</button>\n            \n  </div>\n{% if data %}\n<div class=\"table-responsive mt-0\">\n    <table class=\"table table-hover align-middle mt-0\">\n        <thead class=\"table-light\">\n<tr>\n    <th>{{ _(\"Invoice No\") }}</th>\n    <th>{{ _(\"Status\") }}</th>\n    <th>{{ _(\"Outlet\") }}</th>\n    <th class=\"text-center\">{{ _(\"Quantity\") }}</th>\n    <th class=\"text-right\">{{ _(\"Total Amount\") }}</th>\n    <th>{{ _(\"Created By\") }}</th>\n    <th>{{ _(\"Date\") }}</th>\n</tr>\n\n        </thead>\n        <tbody>\n\n        {% for row in data %}\n\n      \n\n            {# ---- status badge color ---- #}\n            {% set badge = \"orange\" %}\n            {% if row.status == \"Paid\" %}\n                {% set badge = \"green\" %}\n            {% elif row.status == \"Unpaid\" %}\n                {% set badge = \"red\" %}\n            {% endif %}\n\n            <tr style=\"cursor:pointer; background-color: {{ bg }};\"\n                onclick=\"frappe.set_route('Form', 'Sale', '{{ row.id }}')\">\n\n                <td class=\"fw-semibold text-primary\">\n                    {{ row.id }}\n                </td>\n\n                <td>\n                    <span class=\"indicator-pill {{ badge }} no-indicator-dot whitespace-nowrap\"\n                          style=\"border:1px solid;\">\n                        {{ _(row.status) }}\n                    </span>\n                </td>\n\n                <td>\n                    {{ _(row.outlet) or \"-\" }}\n                </td>\n\n                <td class=\"text-center fw-semibold\">\n                    {{ row.quantity | int }}\n                </td>\n\n                <td class=\"text-right fw-bold text-success\">\n                    {{ frappe.format_value(row.total_amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n\n                <td>\n            {{ row.created_by.split('@')[0] }}\n\n                </td>\n\n               <td title=\"{{ frappe.utils.format_datetime(row.created_date, 'dd-MM-yyyy HH:mm') }}\"\n >\n    {{ frappe.utils.pretty_date(row.created_date) }}\n</td>\n            </tr>\n\n        {% endfor %}\n        </tbody>\n    </table>\n</div>\n\n{% else %}\n<div class=\"text-center text-muted py-4\">\n   {{_(\"No Data\")}} \n</div>\n{% endif %}\n</div>\n",
  "template_name": "html_customer_recent_sale"
 },
 {
  "css": null,
  "docstatus": 0,
  "doctype": "HTML Template",
  "modified": "2025-12-24 16:55:46.099362",
  "name": "html_payment_history",
  "template": "{% set data = frappe.db.sql(\"\"\"\n    SELECT\n        name AS id,\n        customer_name,\n        posting_date,\n        total_amount,\n        owner AS created_by,\n        outlet,\n        balance,\n        amount_to_pay,\n        payment_amount,\n        write_off_amount,\n        creation AS created_date\n    FROM `tabSale Payment`\n    WHERE sale = %(name)s\n    ORDER BY creation asc\n    LIMIT 20\n\"\"\", {\"name\": doc.name}, as_dict=1) %}\n\n<div class=\"card shadow-sm pb-0\">\n  <div class=\"card-header d-flex justify-content-between align-items-center\">\n    <h5 class=\"mb-0\">{{_(\"Payments\")}}</h5>\n   \n               <button class=\"btn btn-sm btn-primary\"\n        onclick=\"\n            frappe.route_options = { sale: '{{ doc.name }}' };\n            frappe.set_route('List', 'Sale Payment');\n        \">\n    {{ _('View All') }}\n</button>\n  </div>\n{% if data %}\n<div class=\"table-responsive mt-0\">\n    <table class=\"table table-hover align-middle mt-0\">\n        <thead class=\"table-light\">\n<tr>\n    <th>{{ _(\"Invoice No\") }}</th>\n    <th>{{ _(\"Payment Date\") }}</th>\n    <th>{{ _(\"Customer\") }}</th>\n    <th>{{ _(\"Outlet\") }}</th>\n    <th class=\"text-right\">{{ _(\"Sale Balance\") }}</th>\n    <th class=\"text-right\">{{ _(\"Payment Amount\") }}</th>\n    <th class=\"text-right\">{{ _(\"Write Off Amount\") }}</th>\n    <th class=\"text-right\">{{ _(\"Balance\") }}</th>\n    <th>{{ _(\"Created By\") }}</th>\n    <th>{{ _(\"Date\") }}</th>\n</tr>\n\n        </thead>\n        <tbody>\n\n        {% for row in data %}\n\n\n            <tr style=\"cursor:pointer; background-color: {{ bg }};\"\n               onclick=\"frappe.set_route('Form', 'Sale Payment', '{{ row.id }}')\">\n\n                <td class=\"fw-semibold text-primary\">\n                    {{ row.id }}\n                </td>\n                 <td class=\"fw-semibold text-primary\">\n                  {{ row.posting_date.strftime('%d-%m-%Y') }}\n\n\n                </td>\n\n\n                <td>\n                    {{ row.customer_name or \"-\" }}\n                </td>\n\n                <td>\n                    {{ _(row.outlet) or \"-\" }}\n                </td>\n                <td class=\"text-right fw-bold\">\n                     {{ frappe.format_value(row.amount_to_pay, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold text-success\">\n                      {{ frappe.format_value(row.payment_amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold  text-danger\">\n                    {{ frappe.format_value(row.write_off_amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td class=\"text-right fw-bold\">\n                    {{ frappe.format_value(row.balance, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n\n                <td>\n            {{ row.created_by.split('@')[0] }}\n\n                </td>\n\n              <td title=\"{{ frappe.utils.format_datetime(row.created_date, 'dd-MM-yyyy HH:mm') }}\"\n >\n    {{ frappe.utils.pretty_date(row.created_date) }}\n</td>\n\n            </tr>\n\n        {% endfor %}\n        </tbody>\n\n\n    </table>\n</div>\n\n{% else %}\n<div class=\"text-center text-muted py-4\">\n   {{_(\"No Data\")}} \n</div>\n{% endif %}\n</div>\n",
  "template_name": "html_payment_history"
 },
